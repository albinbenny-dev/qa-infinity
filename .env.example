# ════════════════════════════════════════════════════════════════════════════
# QA Infinity — Environment Variables Template
#
# 1. Copy this file to .env:    cp .env.example .env
# 2. Fill in the required (★) values below.
# 3. Never commit .env to git — it is already in .gitignore.
# ════════════════════════════════════════════════════════════════════════════

# ── App mode ────────────────────────────────────────────────────────────────
# full   — complete platform with AI agents (default, requires ANTHROPIC_API_KEY)
# runner — no AI features; TC Library, Scripts, Execution, Scheduler, Reports only
#           safe for air-gapped / client servers with no internet access
APP_MODE=full

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── CORS (URL the browser uses to reach the UI) ─────────────────────────────
CORS_ORIGIN=http://localhost:3100

# ── App URL ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3100

# ── Auth domain restriction ───────────────────────────────────────────────────
# Only emails from these domains can register. Leave blank to allow any domain.
ALLOWED_DOMAINS=6dtech.co.in

# ── Database credentials ★ ────────────────────────────────────────────────────
# Used by Docker Compose to initialize Postgres on first boot.
# Pick any strong password — must stay consistent once the DB is initialized.
POSTGRES_USER=qauser
POSTGRES_DB=qa_infinity
POSTGRES_PASSWORD=change-me-use-a-strong-password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank to run Redis without a password (fine for local dev).
REDIS_PASSWORD=

# ── JWT Auth ★ ───────────────────────────────────────────────────────────────
# Generate: paste 2–3 random UUIDs together (https://www.uuidgenerator.net)
JWT_SECRET=paste-several-uuids-concatenated-here
JWT_EXPIRES_IN=7d

# ════════════════════════════════════════════════════════════════════════════
# AI / LLM PROVIDER — choose ONE of the three options below and uncomment it
# ════════════════════════════════════════════════════════════════════════════

# ── Option A: OpenRouter (recommended for most users) ────────────────────────
# Get your key at: https://openrouter.ai/keys
#LLM_PROVIDER=openrouter
#OPENROUTER_API_KEY=sk-or-v1-...
#OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# ── Option B: Direct Anthropic API ★ (current team default) ──────────────────
# Get your key at: https://console.anthropic.com/settings/keys
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Option C: ITOPS On-Prem LLM (LiteLLM proxy — internal network only) ──────
#LLM_PROVIDER=local
#LOCAL_LLM_BASE_URL=http://10.0.6.31:4000/v1
#LOCAL_LLM_API_KEY=ask-itops-team
#LOCAL_LLM_MODEL=6d-devops-llm
#LOCAL_LLM_SCRIPT_MODEL=qwen3.6-35b-a3b

# ── Jira Integration (optional — needed for Writer Agent Jira input) ──────────
# Host: your Atlassian domain, e.g. https://yourcompany.atlassian.net/
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=https://sixdee.atlassian.net/
JIRA_EMAIL=you@6dtech.co.in
JIRA_API_TOKEN=

# ── Email / SMTP (optional — needed for report emails) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QA Infinity <no-reply@6dtech.co.in>

# ── Runner ───────────────────────────────────────────────────────────────────
RUNNER_CONTAINER_NAME=qa-runner
PLAYWRIGHT_WORKERS=2

# Host port for the noVNC live-browser viewer. Only change this if port 6180
# is already taken on the machine that will BROWSE this instance — e.g. running
# a local dev stack and tunnelling into a remote one at the same time both
# default to 6180. The frontend reads this back at runtime (GET /api/app-config)
# so it opens the viewer on whichever port this instance is actually mapped to.
NOVNC_HOST_PORT=6180

# Max number of host-browser/recording sessions that can be watched live via
# VNC at the same time. Each claimed slot is a real headed Chromium process
# once a run starts, so this is a real resource ceiling, not just a UI limit —
# turn it down if the server is struggling under concurrent live-viewed runs.
MAX_VNC_SESSIONS=6

# ── File size limits ─────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800

# ── Data retention ───────────────────────────────────────────────────────────
RETENTION_RUNRESULT_DAYS=90
RETENTION_HEAL_DAYS=30
RETENTION_LLMCALL_DAYS=90
RETENTION_ARTIFACTS_DAYS=30
RETENTION_VIDEO_DAYS=30
RETENTION_TRACE_DAYS=14
RETENTION_SCREENSHOT_DAYS=30
MAX_RUNS_PER_PROJECT=500
