# ═══════════════════════════════════════════════════════════════════════════
# QA Infinity — Helm secrets template (K8s equivalent of .env.example)
#
# 1. Copy this file:    cp values-secrets.yaml.example values-secrets.yaml
# 2. Fill in the required values below.
# 3. Never commit values-secrets.yaml to git — it is already in .gitignore.
#
# Usage:
#   helm upgrade --install qa-infinity ./helm/qa-infinity \
#     -f ./helm/qa-infinity/values.yaml \
#     -f ./values-secrets.yaml \
#     --set image.registry=harbor.internal.example.com/qa-infinity \
#     --set image.tag=<commit-sha> \
#     --namespace qa-infinity
# ═══════════════════════════════════════════════════════════════════════════

secrets:
  postgresUser: qauser
  postgresDb: qa_infinity
  postgresPassword: "" # ★ required — any strong password
  redisPassword: "" # leave blank for no auth (internal cluster network only)
  jwtSecret: "" # ★ required — paste 2-3 random UUIDs concatenated
  # Fill in whichever matches values.yaml's llm.provider:
  openrouterApiKey: ""
  anthropicApiKey: ""
  localLlmApiKey: ""
  jiraApiToken: "" # optional — only if jira.host is set
  smtpPass: "" # optional — only if you want emailed reports
