# ── Dependencies (never needed in build context — installed inside Docker) ──
node_modules
**/node_modules

# ── Build outputs (exclude compiled outputs — but keep extension/dist which
#    is pre-built and copied into the api image) ────────────────────────────
packages/api/dist
packages/frontend/dist
**/.turbo

# ── Local dev / test artifacts ───────────────────────────────────────────────
**/.env
**/.env.local
**/test-results
**/playwright-report
**/coverage

# ── Git / editor ─────────────────────────────────────────────────────────────
.git
.gitignore
.claude
**/.DS_Store

# ── Release tarballs (large, not needed inside image) ────────────────────────
*.tar.gz
*.tar
release-v*/
