generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All enum-like fields use String with application-level validation (Zod).
// Valid values are documented in comments and enforced by Zod schemas.

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  globalRole   String          @default("STANDARD_USER")   // "SUPER_ADMIN" | "ADMIN" | "SUPER_USER" | "STANDARD_USER"
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships    ProjectMember[]
  projects       Project[]       @relation("CreatedBy")
}

model Project {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  baseUrl         String?
  color           String           @default("#22d3ee")
  reqLibraryPath  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String
  creator         User             @relation("CreatedBy", fields: [createdBy], references: [id])

  patternMemory   String?          // JSON: PatternMemory — auto-learned from verified scripts

  // Per-run-type parallelism defaults (configurable in Project Settings → Run Defaults)
  defaultManualWorkers    Int @default(2)
  defaultSuiteWorkers     Int @default(2)
  defaultSchedulerWorkers Int @default(2)

  members         ProjectMember[]
  envConfigs      EnvConfig[]
  requirementDocs RequirementDoc[]
  testCases       TestCase[]
  scripts         Script[]
  scriptJobs      ScriptJob[]
  runs            Run[]
  schedules       Schedule[]
  suites          Suite[]
  heals           Heal[]
  reports         Report[]
  chatMessages    ChatMessage[]
  chatMemories    ChatMemory[]
  uiScans         UIScan[]
  projectContext  ProjectContext?
  agentTraces     AgentTrace[]
  resources       ProjectResource[]
  skills          ProjectSkill[]
  jiraIssues      JiraIssue[]
  jiraConfig      JiraConfig?
  locatorEntries  LocatorEntry[]
  scriptEdits     ScriptEdit[]

  @@index([createdBy])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("SUPER_USER")  // "ADMIN" | "SUPER_USER" | "STANDARD_USER"
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model EnvConfig {
  id        String   @id @default(cuid())
  projectId String
  name      String
  baseUrl   String
  username  String?
  password  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model RequirementDoc {
  id         String   @id @default(cuid())
  projectId  String
  filename   String
  filePath   String
  fileType   String
  isActive   Boolean  @default(true)
  uploadedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, isActive])
}

model TestCase {
  id             String      @id @default(cuid())
  projectId      String
  tcId           String
  title          String
  description    String?
  steps          String      @default("[]")
  expectedResult String
  type           String      @default("UI")       // "UI" | "API" | "SIT"
  tags           String      @default("[]")
  useCaseTag     String?
  status         String      @default("DRAFT")    // "DRAFT" | "APPROVED" | "DEPRECATED"
  priority       String      @default("MEDIUM")   // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  sourceRef        String?
  generationHints  String?   // free-text locator/context hints injected into script agent
  runtimeVariables String?   // JSON: [{name, captureFrom, description?}] — dynamic values captured during test run
  sortOrder        Int       @default(0)        // within useCaseTag group (drag-to-reorder)
  prerequisiteTcId String?                                                        // optional FK to another TC
  prerequisiteTc   TestCase?  @relation("PrerequisiteOf", fields: [prerequisiteTcId], references: [id], onDelete: SetNull)
  dependentTcs     TestCase[] @relation("PrerequisiteOf")
  linkedScriptId   String?                                                        // TC Library → Script link (N TCs → 1 script)
  linkedScript     Script?   @relation("TCLinkedScript", fields: [linkedScriptId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scripts          Script[]
  runResults       RunResult[]
  @@unique([projectId, tcId])
  @@index([projectId])
  @@index([projectId, useCaseTag])
  @@index([projectId, status])
  @@index([projectId, type])
}

model Script {
  id                 String      @id @default(cuid())
  projectId          String
  testCaseId         String?
  filename           String
  content            String
  scriptType         String      @default("PLAYWRIGHT")     // "PLAYWRIGHT" | "ROBOT"
  isCustomUpload     Boolean     @default(false)
  useCaseFolder      String?     @default("_uncategorized") // on-disk subfolder under {slug}/scripts/
  isGolden           Boolean     @default(false)           // marked as a reference example for few-shot generation
  verificationStatus String      @default("NOT_VERIFIED")  // "NOT_VERIFIED" | "VERIFIED" | "MANUAL_REVIEW"
  suspectedIssue     String?     // AI-suggested cause when MANUAL_REVIEW
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase           TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  linkedTestCases    TestCase[]  @relation("TCLinkedScript")
  runResults         RunResult[]
  scriptJobs         ScriptJob[]
  edits              ScriptEdit[]

  @@index([projectId])
  @@index([testCaseId])
}

// ── Object/Locator Repository ───────────────────────────────────────────────
// A persisted, named, per-project element store — the "source of truth" a
// script-generation call selects locators FROM instead of inventing new ones.
// Populated automatically from passing runs (see extractAndLockLocators) and
// from approved manual corrections (see ScriptEdit below); confidence grows
// with successCount and shrinks with failCount, Healenium/Testim-style.
model LocatorEntry {
  id                String   @id @default(cuid())
  projectId         String
  name              String   // stable identity, e.g. "LOGIN.USERNAME_INPUT" — independent of the selector string
  page              String?  // scoping key — feature group / page this element belongs to
  selector          String   // the verified locator, e.g. "css=#username"
  strategy          String   // "id" | "css" | "role" | "text" | "xpath"
  domContext        String?  // JSON: sibling/parent fingerprint snapshot for future re-resolution
  confidence        Float    @default(0.6)
  successCount      Int      @default(0)
  failCount         Int      @default(0)
  sourceRunId       String?  // Run.id that first proved this locator
  lastVerifiedRunId String?  // Run.id of the most recent confirming run
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, page])
  @@index([projectId, selector])
}

// ── Script correction feedback loop ─────────────────────────────────────────
// Every manual edit to a generated script's content is recorded here so the
// correction can be classified and, once approved, promoted into the
// LocatorEntry repository or the golden-examples pool — the loop that was
// previously entirely absent (a plain content overwrite taught the system
// nothing). See routes/scripts.ts PUT /:id/content and services/scriptDiff.ts.
model ScriptEdit {
  id             String   @id @default(cuid())
  scriptId       String
  projectId      String
  previousContent String
  newContent     String
  diffSummary    String?  // JSON: ScriptDiffSummary — locator/step/data changes detected
  classification String   @default("UNCLASSIFIED") // "LOCATOR_SWAP" | "STRUCTURAL" | "DATA" | "UNCLASSIFIED"
  promoted       Boolean  @default(false) // whether this correction has been written back into the repository/golden examples
  editedBy       String?
  createdAt      DateTime @default(now())
  script         Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([scriptId])
  @@index([projectId, classification])
}

model ScriptJob {
  id              String    @id @default(cuid())
  projectId       String
  testCaseId      String
  scriptId        String?
  createdBy       String?   // userId who initiated this job (null for legacy rows)
  phase           String    @default("QUEUED")    // "QUEUED" | "GENERATING" | "GENERATED" | "QUEUED_VERIFY" | "VERIFYING" | "HEALING" | "VERIFIED" | "MANUAL_REVIEW" | "FAILED"
  withHeal        Boolean   @default(false)
  healAttempts    Int       @default(0)
  maxHealAttempts Int       @default(2)
  lastError       String?
  suspectedIssue  String?
  healType        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  script          Script?   @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, phase])
  @@index([projectId, createdAt])
  @@index([projectId, createdBy])
}

model Run {
  id                String    @id @default(cuid())
  projectId         String
  runSeq            Int       @default(0)          // global auto-increment assigned at creation
  name              String
  environment       String
  status            String    @default("PENDING")  // "PENDING" | "RUNNING" | "PASSED" | "FAILED" | "CANCELLED"
  startedAt         DateTime?
  completedAt       DateTime?
  triggerType       String    @default("MANUAL")   // "MANUAL" | "SCHEDULED" | "INDIVIDUAL" | "GROUP" | "HEAL_RERUN"
  parallelWorkers   Int       @default(2)
  createdAt         DateTime  @default(now())
  createdByUserId   String?                        // null for scheduled/heal runs; set to req.user.id for manual runs
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results           RunResult[]
  report            Report?

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model RunResult {
  id             String    @id @default(cuid())
  runId          String
  testCaseId     String
  scriptId       String?
  status         String    // "PENDING" | "RUNNING" | "PASSED" | "FAILED" | "CANCELLED" | "SKIPPED"
  duration       Int?
  errorMessage   String?
  screenshotPath String?
  tracePath      String?
  videoPath      String?
  rfReportPath   String?
  rfLogPath      String?
  createdAt      DateTime  @default(now())
  run            Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase       TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  script         Script?   @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  heals          Heal[]

  @@unique([runId, testCaseId])
  @@index([runId])
  @@index([testCaseId])
}

model Schedule {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  cronExpression  String
  suiteId         String?
  testCaseIds     String   @default("[]")
  environment     String
  isActive        Boolean  @default(true)
  emailRecipients String   @default("[]")
  parallelWorkers Int      @default(2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, isActive])
}

model Suite {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  stages      String   @default("[]")  // JSON: SuiteStage[]
  testCaseIds String   @default("[]")  // JSON: string[] — kept for backward compat / CI/CD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Heal {
  id           String      @id @default(cuid())
  projectId    String
  runResultId  String
  type         String      // "SELECTOR" | "FLOW" | "API_SCHEMA"
  originalCode String
  patchedCode  String
  confidence   Int
  summary      String?     // AI explanation from patcher chain
  status       String      @default("PENDING")  // "IN_PROGRESS" | "PENDING" | "APPROVED" | "REJECTED" | "AUTO_APPLIED" | "EXHAUSTED"
  agentTraceId String?     @unique // set when a live browser trace was run to diagnose the failure
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runResult    RunResult   @relation(fields: [runResultId], references: [id], onDelete: Cascade)
  agentTrace   AgentTrace? @relation("HealTrace", fields: [agentTraceId], references: [id])

  @@index([projectId])
  @@index([projectId, status])
}

model Report {
  id          String    @id @default(cuid())
  projectId   String
  runId       String    @unique
  summary     String
  aiAnalysis  String
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run         Run       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  projectId      String
  conversationId String
  role           String   // "user" | "assistant"
  content        String
  actionType     String?
  actionPayload  String?  // JSON: structured data for action cards
  attachments    String?  // JSON: [{name, mimeType}] metadata only
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, conversationId])
}

model ChatMemory {
  id        String   @id @default(cuid())
  projectId String
  content   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model UIScan {
  id           String    @id @default(cuid())
  projectId    String
  status       String    @default("PENDING")  // "PENDING"|"RUNNING"|"COMPLETED"|"FAILED"
  triggeredBy  String
  startedAt    DateTime?
  completedAt  DateTime?
  progress     Int       @default(0)          // 0–100
  currentPage  String?
  pagesTotal   Int       @default(0)
  pagesScanned Int       @default(0)
  rawPageData  String?                        // JSON: PageScanData[]
  errorMessage String?
  createdAt    DateTime  @default(now())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, status])
}

model ProjectContext {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  loginInstructions  String?  // JSON: LoginInstructions
  navigationMap      String?  // JSON: NavNode[]
  pageLocators       String?  // JSON: Record<urlPattern, PageLocators>
  useCaseSummary     String?  // JSON: UseCaseSummary[]
  customInstructions String?  // Free-text guidance for scanner & agents
  pendingTCDraft     String?  // JSON: GeneratedTestCase[] awaiting review in Test Writer
  agentLearnings     String?  // JSON: AgentLearning[] — verified locators/flows per menu from agentic traces
  lastScanId         String?
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AgentTrace {
  id           String    @id @default(cuid())
  projectId    String
  // "QUEUED" | "RUNNING" | "COMPLETED" | "FAILED" | "BLOCKED"
  status       String    @default("QUEUED")
  testGoal     String
  menuContext  String?
  targetUrl    String?
  stepCount    Int       @default(0)
  currentStep  String?
  actionLog    String?   // JSON: RecordedAction[]
  videoPath    String?   // absolute path to the .webm recording on disk
  errorMessage String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  heal         Heal?     @relation("HealTrace")  // back-ref: set when trace was spawned by healing agent

  @@index([projectId])
  @@index([projectId, status])
}

model AgentConfig {
  agentName String   @id
  enabled   Boolean  @default(true)
  settings  String?  // JSON: agent-specific settings (e.g. {"selectorTraceThreshold":60} for healing-agent)
  updatedAt DateTime @updatedAt
}

model ProjectResource {
  id           String   @id @default(cuid())
  projectId    String
  filename     String
  originalName String
  size         Int
  uploadedAt   DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, filename])
  @@index([projectId])
}

model ProjectSkill {
  id             String   @id @default(cuid())
  projectId      String
  skillType      String   // "UI_FLOW" | "BUSINESS_USE_CASE" | "TEST_DATA" | "HLD" | "API_CONTRACT" | "USER_ROLE" | "UX_DESIGN" | "HISTORICAL" | "FUNCTIONAL_RULES" | "LOCATOR_GUIDE" | "TEST_CASE_DOC"
  name           String
  scope          String?
  featureGroup   String?  // groups related skills under one feature (e.g. "Stock Creation")
  tier           String   @default("FEATURE") // "GLOBAL" | "FEATURE" | "HISTORICAL" — controls injection scope
  content        String   // JSON — schema varies by skillType
  humanContext   String?  // plain-text QA engineer correction or annotation (used by HISTORICAL skills)
  captureMethod  String   @default("MANUALLY_ENTERED") // "AGENT_RECORDED" | "USER_UPLOADED" | "MANUALLY_ENTERED" | "LLM_EXTRACTED" | "AUTO_ACCUMULATED" | "MANUAL_QA_FEEDBACK"
  confidence     Float    @default(0.8)
  isActive       Boolean  @default(true)
  capturedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, skillType])
  @@index([projectId, isActive])
  @@index([projectId, featureGroup])
}

model JiraIssue {
  id             String    @id @default(cuid())
  projectId      String
  issueKey       String
  summary        String?
  status         String?
  statusCategory String?   // "new" | "indeterminate" | "done"
  issueType      String?
  priorityName   String?
  labels         String    @default("[]")   // JSON: string[]
  components     String    @default("[]")   // JSON: string[]
  assigneeName   String?
  reporterName   String?
  jiraCreatedAt  DateTime?
  dueDate        DateTime?
  jiraUpdatedAt  DateTime?
  lastSyncedAt   DateTime
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, issueKey])
  @@index([projectId])
}

model JiraConfig {
  id                  String    @id @default(cuid())
  projectId           String    @unique
  jiraHost            String?   // e.g. "https://yourcompany.atlassian.net"
  jiraEmail           String?
  jiraApiToken        String?
  jiraProjectKey      String?
  pollIntervalMinutes Int       @default(5)
  isEnabled           Boolean   @default(false)
  lastPollAt          DateTime?
  lastPollStatus      String?
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LlmCall {
  id               String   @id @default(cuid())
  agentName        String   // "script-agent" | "healing-agent" | "writer-agent" | "chat-agent" | "reports-agent" | "ui-context-agent"
  projectId        String?
  projectName      String?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([agentName])
  @@index([projectId])
  @@index([createdAt])
}

// ── Infrastructure metrics ───────────────────────────────────────────────────
// Platform-level, not project-scoped — sampled by an out-of-band host cron
// script (scripts/collect-container-metrics.sh) that runs `docker stats` and
// reads /proc directly on the host, then POSTs a batch to
// POST /admin/metrics/ingest. Deliberately NOT collected by qa-api itself —
// the app never touches the Docker socket or the host filesystem for this.

model HostMetricSample {
  id            String   @id @default(cuid())
  timestamp     DateTime
  cpuCores      Int
  cpuPercent    Float    // host-wide CPU utilization at sample time
  memTotalBytes Float    // stored as Float (not BigInt) — values are well within
  memUsedBytes  Float    // Number's safe-integer range and this avoids BigInt's
  createdAt     DateTime @default(now()) // JSON-serialization friction entirely

  @@index([timestamp])
}

model ContainerMetricSample {
  id            String   @id @default(cuid())
  timestamp     DateTime
  container     String   // e.g. "qa-api", "qa-runner", "qa-postgres", "qa-redis", "qa-ui"
  cpuPercent    Float
  memUsedBytes  Float
  memLimitBytes Float?
  netRxBytes    Float?
  netTxBytes    Float?
  createdAt     DateTime @default(now())

  @@index([timestamp])
  @@index([container, timestamp])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}
